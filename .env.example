# Google AdSense configuration.
# The publisher ID is public and defaults to the value baked into the app.
VITE_ADSENSE_CLIENT=ca-pub-6689056038494624

# Ad unit slot IDs from AdSense > Ads > By ad unit.
# Leave empty to omit a slot; the AdSlot component renders nothing in production.
VITE_ADSENSE_SLOT_TOP=
VITE_ADSENSE_SLOT_BOTTOM=
